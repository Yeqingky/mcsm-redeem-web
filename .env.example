VITE_API_BASE_URL=http://localhost:8080 # 浏览器访问的后端 API 基础地址
VITE_SITE_NAME=夜轻面板兑换页 # 左上角站点名称及浏览器标签页标题
VITE_LOGO_URL=https://list.yppp.net/d/cos/yeqing.jpeg # 页面左上角 Logo 图片地址，留空则不显示
VITE_PANEL_URL=https://mcsm.example.com/ # 兑换成功后展示的 MCSManager 面板地址
# VITE_BUILD_COMMIT 一般无需手填：vite.config.ts 构建时会自动执行 git rev-parse 获取当前提交，
# 仅在构建环境没有 .git（如 CI 只打包源码）时才需要在托管平台配置该变量。
